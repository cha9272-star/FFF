# === Claude (분석 · 목표 제시) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# === Google (Gmail · Calendar) OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# === Microsoft 365 (Outlook · Calendar) — Microsoft Graph ===
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/integrations/microsoft/callback

# === App ===
# true 로 두면 자격 증명이 있어도 항상 샘플 데이터 사용
USE_SAMPLE_DATA=auto
CORS_ORIGINS=http://localhost:5173
